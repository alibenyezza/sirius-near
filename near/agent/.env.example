NEAR_NETWORK=testnet
SIRIUS_MARKET=sirius-ali-market.testnet
# Agent account and the near-cli keychain file of its function-call key (market only, order_with_budget only)
SIRIUS_AGENT_ACCOUNT=agent.sirius-ali-carol.testnet
SIRIUS_AGENT_CREDENTIALS=/home/you/.near-credentials/testnet/agent.sirius-ali-carol.testnet/ed25519_<public key>.json
# NEAR AI Cloud API key from https://cloud.near.ai (needed for the completion; attestation works without it)
NEARAI_CLOUD_API_KEY=
# Optional: a private (TEE) model served by NEAR AI Cloud, see GET https://cloud-api.near.ai/v1/models (owned_by "nearai")
NEARAI_MODEL=Qwen/Qwen3.8-27B
